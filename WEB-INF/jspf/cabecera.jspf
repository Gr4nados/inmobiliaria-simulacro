<%--
 cabecera.jspf - Encabezado HTML + barra de navegacion Bootstrap 5.
 Requiere que la pagina defina tituloPagina, ctx y rolSesion antes del include
 (via seguridad.jspf o sesionOpcional.jspf).
--%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= tituloPagina %> | Inmobiliaria</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="<%= ctx %>/css/estilos.css" rel="stylesheet">
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold" href="<%= ctx %>/index.jsp">
            <i class="bi bi-building"></i> Inmobiliaria
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="menu">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="<%= ctx %>/propiedad/listar.jsp">
                        <i class="bi bi-houses"></i> Propiedades</a></li>
                                        <% if ("CLIENTE".equals(rolSesion)) { %>
                <li class="nav-item">
                    <a class="nav-link" href="<%= ctx %>/cita/mis-citas.jsp">
                        <i class="bi bi-calendar-check"></i> Mis citas</a></li>
                        <li class="nav-item">
    <a class="nav-link" href="<%= ctx %>/propiedad/favoritos.jsp">
        <i class="bi bi-heart"></i> Mis favoritos</a></li>
                <% } %>
                <% if ("INMOBILIARIA".equals(rolSesion) || "ADMINISTRADOR".equals(rolSesion)) { %>
                <li class="nav-item">
                    <a class="nav-link" href="<%= ctx %>/cita/agenda.jsp">
                        <i class="bi bi-calendar-week"></i> Agenda</a></li>
                <% } %>
                                <% if ("CLIENTE".equals(rolSesion)) { %>
                <li class="nav-item">
                    <a class="nav-link" href="<%= ctx %>/solicitud/mis-solicitudes.jsp">
                        <i class="bi bi-file-earmark-text"></i> Mis solicitudes</a></li>
                <% } %>
                <% if ("INMOBILIARIA".equals(rolSesion) || "ADMINISTRADOR".equals(rolSesion)) { %>
                <li class="nav-item">
                    <a class="nav-link" href="<%= ctx %>/solicitud/gestion.jsp">
                        <i class="bi bi-inbox"></i> Solicitudes</a></li>
                <% } %>
                                <% if ("ADMINISTRADOR".equals(rolSesion)) { %>
                <li class="nav-item">
                    <a class="nav-link" href="<%= ctx %>/reportes.jsp">
                        <i class="bi bi-bar-chart"></i> Reportes</a></li>
                <% } %>
                                <% if ("ADMINISTRADOR".equals(rolSesion)) { %>
                <li class="nav-item">
                    <a class="nav-link" href="<%= ctx %>/admin/usuarios.jsp">
                        <i class="bi bi-people"></i> Usuarios</a></li>
                <% } %>
                <% if ("INMOBILIARIA".equals(rolSesion) || "ADMINISTRADOR".equals(rolSesion)) { %>
                <li class="nav-item">
                    <a class="nav-link" href="<%= ctx %>/propiedad/nueva.jsp">
                        <i class="bi bi-plus-circle"></i> Nueva propiedad</a></li>
                <% } %>
                <% if (idUsuarioSesion != null) { %>
                <li class="nav-item">
                    <a class="nav-link" href="<%= ctx %>/inicio.jsp">
                        <i class="bi bi-speedometer2"></i> Mi panel</a></li>
                <% } %>
            </ul>
            <% if (idUsuarioSesion != null) { %>
                <span class="navbar-text text-white me-3">
                    <i class="bi bi-person-circle"></i> <%= esc(nombreSesion) %>
                    <span class="badge text-bg-warning ms-1"><%= rolSesion %></span>
                </span>
                <a class="btn btn-outline-light btn-sm" href="<%= ctx %>/logout.jsp">
                    <i class="bi bi-box-arrow-right"></i> Salir</a>
            <% } else { %>
                <a class="btn btn-outline-light btn-sm me-2" href="<%= ctx %>/login.jsp">
                    <i class="bi bi-box-arrow-in-right"></i> Ingresar</a>
                <a class="btn btn-warning btn-sm fw-bold" href="<%= ctx %>/registro.jsp">
                    <i class="bi bi-person-plus"></i> Registrarme</a>
            <% } %>
        </div>
    </div>
</nav>
<main class="container my-4">