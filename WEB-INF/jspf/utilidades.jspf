<%--
 utilidades.jspf - Metodos auxiliares reutilizables en todo el proyecto.
 Se incluye siempre DESPUES de conexion.jspf.
--%>
<%@ page import="java.security.MessageDigest, java.text.NumberFormat, java.util.Locale" %>
<%!
    /** Cifra un texto con SHA-256 y lo devuelve en hexadecimal. */
    public String sha256(String texto) {
        try {
            MessageDigest md = MessageDigest.getInstance("SHA-256");
            byte[] resumen = md.digest(texto.getBytes("UTF-8"));
            StringBuilder sb = new StringBuilder();
            for (byte b : resumen) sb.append(String.format("%02x", b));
            return sb.toString();
        } catch (Exception ex) {
            throw new RuntimeException("Error al cifrar la clave", ex);
        }
    }

    /** Combina usuario y clave antes de cifrar (salt sencillo). */
    public String claveCifrada(String usuario, String clave) {
        return sha256(usuario + ":" + clave);
    }

    /** Formatea un valor como moneda colombiana: 320000000 -> $ 320.000.000 */
    public String pesos(double valor) {
        NumberFormat f = NumberFormat.getInstance(new Locale("es", "CO"));
        f.setMaximumFractionDigits(0);
        return "$ " + f.format(valor);
    }

    /** Convierte a entero un parametro del formulario, con valor por defecto. */
    public int aEntero(String valor, int porDefecto) {
        try { return Integer.parseInt(valor.trim()); }
        catch (Exception ex) { return porDefecto; }
    }

    public double aDoble(String valor, double porDefecto) {
        try { return Double.parseDouble(valor.trim().replace(",", ".")); }
        catch (Exception ex) { return porDefecto; }
    }

    /** Escapa caracteres HTML para evitar ataques XSS. */
    public String esc(String texto) {
        if (texto == null) return "";
        return texto.replace("&", "&amp;").replace("<", "&lt;")
                     .replace(">", "&gt;").replace("\"", "&quot;");
    }

    /** Devuelve el color de Bootstrap correspondiente a cada estado de propiedad. */
    public String colorEstado(String estado) {
        if (estado == null) return "secondary";
        switch (estado) {
            case "DISPONIBLE": return "success";
            case "RESERVADA":  return "warning";
            case "VENDIDA":    return "primary";
            case "INACTIVA":   return "secondary";
            default: return "secondary";
        }
    }
%>